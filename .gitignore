# Device credential cache (id/token/key) — fetched from the cloud, never committed
cache/
secrets.json
*.secret.json
.env

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# Android / Gradle
android/**/build/
android/.gradle/
android/.kotlin/
android/.idea/
local.properties
# (gradle-wrapper.jar is intentionally committed)

# Signing keys
*.jks
*.keystore
keystore.properties

# Raw screenshots for the store listings; only their captions are kept
apple/store/captures/**/*.png
android/store/captures/*.png
